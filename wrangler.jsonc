/**
 * Read-only Mercado Bitcoin MCP server.
 * Free plan: Workers plus two SQLite Durable Objects (auth lockout and request quotas).
 * No paid bindings (no Workers Rate Limiting, AI, Queues, or KV).
 *
 * MB_API_KEY, MB_API_SECRET, and MCP_AUTH_TOKEN are Worker secrets.
 * Names are listed under secrets.required so types exist. Values are never committed.
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mercado-bitcoin-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-30",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"vars": {
		"AUTH_FAILURE_LIMIT": "10",
		"AUTH_FAILURE_WINDOW_SECONDS": "900",
		"AUTH_LOCKOUT_SECONDS": "1800",
		"RATE_LIMIT_PER_MINUTE": "60",
		"RATE_LIMIT_GLOBAL_PER_MINUTE": "600",
		"MB_PUBLIC_PER_SECOND": "1",
		"MB_PRIVATE_PER_SECOND": "3"
	},
	"secrets": {
		"required": ["MB_API_KEY", "MB_API_SECRET", "MCP_AUTH_TOKEN"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTH_RATE_LIMIT",
				"class_name": "AuthRateLimit"
			},
			{
				"name": "REQUEST_RATE_LIMIT",
				"class_name": "RequestRateLimit"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthRateLimit"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["RequestRateLimit"]
		}
	]
}
