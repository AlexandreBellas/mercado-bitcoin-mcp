# Copy to .dev.vars for local `npm run dev`. Never commit .dev.vars.
# Mercado Bitcoin read-only API key (client id) and secret.
MB_API_KEY=
MB_API_SECRET=
# Bearer token required on every POST /mcp request.
MCP_AUTH_TOKEN=

# Optional lockout overrides. Wrangler vars are the defaults:
# 10 failures / 900 seconds, then an 1800 second lockout.
# AUTH_FAILURE_LIMIT=10
# AUTH_FAILURE_WINDOW_SECONDS=900
# AUTH_LOCKOUT_SECONDS=1800

# Optional request quotas. Defaults: 60/minute per bearer, 600/minute global,
# 1 public Mercado Bitcoin call/second, 3 private calls/second.
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_GLOBAL_PER_MINUTE=600
# MB_PUBLIC_PER_SECOND=1
# MB_PRIVATE_PER_SECOND=3
