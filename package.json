{
  "name": "mercado-bitcoin-mcp",
  "version": "2.0.0",
  "description": "Read-only Mercado Bitcoin MCP server for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "mcp",
    "mercado-bitcoin",
    "cloudflare-workers",
    "read-only",
    "model-context-protocol"
  ],
  "author": "RodrigoFlorencio86",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreBellas/mercado-bitcoin-mcp.git"
  },
  "homepage": "https://github.com/AlexandreBellas/mercado-bitcoin-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlexandreBellas/mercado-bitcoin-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "body-parser": "2.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "fast-uri": "3.1.9",
    "hono": "4.13.14",
    "ip-address": "10.7.5",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "tinypool": "2.2.0"
  }
}
